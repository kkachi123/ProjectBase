.hutong-fsm-info-window {
}

.hutong-section {
    margin-bottom: 12px;
}

.hutong-node-inspector-header__title-row {
    margin-right: 4px;
}

UsedCountLabel {
    padding-right: 4px;
}

.hutong-fsm-info-window__scroll-view {
    padding-left: 6px;
}

.unity-scroll-view__content-container{
    padding-top: 16px;
}

.hutong-fsm-info-window__list-item {
    background-color: var(--unity-colors-toolbar-background);
    flex-direction: row;
    flex-grow: 1;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0,0,0,.1);
}

.hutong-fsm-info-window__list-item-icon {
    width: 16px;
    flex-grow: 0;
    margin-right: 2px;
}

.hutong-fsm-info-window__list-item-label {
    flex-grow: 1;
}

.hutong-fsm-info-window__none-label {
    margin-top: 3px;
    opacity: 0.5;
}

.hutong-fsm-info-window__info-row {
    flex-direction: row;
    align-items: center;
    height: 20px;
}
.hutong-fsm-info-window__info-row:hover {
    background-color: var(--unity-colors-toolbar-background);
}

.hutong-fsm-info-window__label-column {
    width: 100px;
    flex-shrink: 0;
    opacity: 0.75;
}

.hutong-fsm-info-window__info-column {
    flex-grow: 1;
    opacity: 0.5;
}

/*
 Action Type Field
 */

.hutong-action-type-field {
    padding-left: 6px;
    padding-right: 4px;
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    height: 28px;
}

.hutong-action-type-field__icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

.hutong-action-type-field__right-aligned {
    flex-direction: row-reverse;
    align-items: center;
    position: absolute;
    right: 40px;
    top: 0;
    bottom: 0;
    justify-content: center;
}

.hutong-action-type-field__name {
    margin-left: 4px;
    flex-grow: 1;
    -unity-font-style: bold;
    text-overflow: ellipsis;
}