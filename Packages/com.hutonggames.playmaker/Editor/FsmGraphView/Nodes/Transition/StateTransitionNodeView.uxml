    </ui:VisualElement>
    <ui:VisualElement name="selection-border" picking-mode="Ignore" class="hutong-node-view__selection-border hutong-state-transition-view__selection-border" />
    <ui:VisualElement name="links" class="hutong-transition-view__links" picking-mode="Ignore">
        <HutongGames.PlayMaker.Editor.LinkDragZone name="any-link" class="hutong-transition-view__link hutong-state-transition-view__link hutong-transition-view__any-link "/>
        <HutongGames.PlayMaker.Editor.LinkDragZone name="left-link" class="hutong-transition-view__link hutong-transition-view__left-link "/>
        <HutongGames.PlayMaker.Editor.LinkDragZone name="right-link" class="hutong-transition-view__link hutong-transition-view__right-link"/>
        <HutongGames.PlayMaker.Editor.LinkDragZone name="bottom-link" class="hutong-transition-view__link hutong-transition-view__bottom-link"/>
        <HutongGames.PlayMaker.Editor.LinkDragZone name="top-link" class="hutong-transition-view__link hutong-transition-view__top-link"/>
    </ui:VisualElement>
</ui:UXML>
