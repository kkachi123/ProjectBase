<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Packages/com.hutonggames.playmaker/Editor/FsmGraphView/FsmGraphView.uss?fileID=7433441132597879392&amp;guid=14cef0a77de71f04797aabda10fc1ea0&amp;type=3#FsmGraphView" />    
    <ui:VisualElement name="header" class="hutong-node-view__header hutong-fsm-view__header">
        <ui:VisualElement name="debug-container" class="hutong-node-view__debug-container">
            <ui:VisualElement name="breakpoint" picking-mode="Ignore" class="hutong-node-view__breakpoint" />
            <ui:VisualElement name="error-icon" class="hutong-node-view__error-icon" />
            <ui:Label name="loop-count" tabindex="-1" text="0" display-tooltip-when-elided="true" class="hutong-node-view__loop-count" />
        </ui:VisualElement>
        <ui:VisualElement name="icon" class="hutong-node-view__icon" />
        <ui:Label name="title" text="FSM" class="pm-host--editable-label unity-text-element unity-label hutong-node-view__title" />
