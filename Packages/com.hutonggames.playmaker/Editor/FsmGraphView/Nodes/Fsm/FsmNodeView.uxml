    </ui:VisualElement>
    <ui:VisualElement name="selection-border" picking-mode="Ignore" class="hutong-node-view__selection-border" />
    <ui:VisualElement name="runtime-state" picking-mode="Ignore" class="hutong-node-view__runtime-state" style="visibility: hidden;" />
    <ui:VisualElement name="content" picking-mode="Ignore" class="hutong-node-view__content-area hutong-fsm-view__content-area" />
    <HutongGames.PlayMaker.Editor.NodeDescription />
</ui:UXML>
