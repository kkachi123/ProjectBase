.hutong-comment-view {
    min-width: 32px;
    min-height: 32px;
    flex-grow: 1;
}

.hutong-comment-view__frame {
    border-color: rgb(255, 0, 0);
    border-width: 1px;
    border-radius: 3px;
    flex-grow: 1;
}

.hutong-comment-view__container {
    overflow: hidden;
    text-overflow: ellipsis;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
}

.hutong-comment-view__text {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 8px;
    white-space: normal;
    overflow: hidden;
    text-overflow: ellipsis;
    color: rgba(0,0,0,0.8);
}

.hutong-comment-view__text-field {
    flex-grow: 1;
    padding-left: 8px;
    padding-right: 8px;
    white-space: normal;
    flex-wrap: wrap;
}

.hutong-node-view__selection-border {
    border-radius: 7px;
}
