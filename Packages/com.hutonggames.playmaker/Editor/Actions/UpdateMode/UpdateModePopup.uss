.hutong-update-mode-popup__toggle {
    flex-direction: row-reverse;
    flex-grow: 1;
    margin-left: 4px;
    margin-right: 5px;
}

.hutong-update-mode-popup__toggle > Label {
    flex-grow: 1;
}

.hutong-update-mode-popup__toggle > .unity-toggle__input {
    width: 16px;
    flex-grow: 0;
}

.hutong-update-mode-popup__container {
    padding: 2px; 
    flex-shrink: 0;
}

.hutong-update-mode-popup__description {
    white-space: normal;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 4px;
    padding-right: 4px;
    opacity: 0.6;
}

.hutong-divider {
    border-bottom-color: rgba(0, 0, 0, 0.2);
    border-bottom-width: 1px;
    height: 3px;
    margin-top: 3px;
    margin-bottom: 3px;
}