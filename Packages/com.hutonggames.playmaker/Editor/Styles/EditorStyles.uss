.hutong-editor-variables {
    --hutong-editor-selected-child-item-color: #344350;
    --hutong-editor-color-drag-line-hover: #656565;
    --hutong-tag-color-ai: #D55E99;
    --hutong-tag-color-ui: #CE5ACE;
    --hutong-tag-color-2d: #458588;
    --hutong-tag-color-audio: #BA800D;
    --hutong-tag-color-video: #BA800D;
    --hutong-tag-color-animation: #6082D2;
    --hutong-tag-color-physics: #6D929C;
}

.hutong-editor-icon-tint {
    -unity-background-image-tint-color: var(--hutong-editor-colors-icon-tint);
}

.hutong-flexible-space {
    flex-basis: 0;
    flex-grow: 1;
}

.foldout-no-indent .unity-foldout__content {
    margin-left: 0;
    padding-left: 0;
}

.hutong-window-title {
    font-size: 24px;
    padding: 8px;
}

.hutong-image-button {
    height: 24px;
    padding-left: 24px;
    background-position: left;
    background-position-x: left 4px;
    background-size: 16px 16px;
}

.hutong-finder-highlight {
    border-width: 1px;
    border-color: var(--hutong-highlight-color);
    background-color: var(--hutong-highlight-background-color);
    border-radius: 4px;
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
}

.hutong-finder-highlight--hidden {
    position: relative;
    height: 16px;
    margin: 8px;
}

.hutong-finder-highlight--hidden > Label {
    opacity: 0.5;
}

ActionEditor .hutong-finder-highlight {
    left: 2px;
}

.hutong-better-text-field__placeholder  {
    position: absolute;
    top: 2px;
    opacity: 0.2;
}

.unity-two-pane-split-view__dragline-anchor {
    background-color: var(--unity-colors-button-border_accent);
}

/*
.unity-two-pane-split-view__dragline-anchor--vertical {
    height: 2px;
}*/

.hide {
    display: none;
}

.hutong-row {
    flex-direction: row;
    align-items: center;
}

.hutong-flex-grow {
    flex-grow: 1;
}

.hutong-info-title-row {
    margin-bottom: 10px;
}

.hutong-info-title {
    -unity-font-style: bold;
}

.hutong-info-more {
    opacity: 0.5;
    margin-bottom: 10px;
}

.hutong-spacer-item {
    height: 16px;
    min-height: 16px;
}

.hutong-group-item {
    flex-direction: row;
    align-items: center;
    background-color: transparent;
    height: 40px;
}

.hutong-group-item > EditableLabel {
    margin-left: 0;
    font-size: 14px;
    flex-grow: 1;
}

.hutong-group-item__foldout {
    margin-left: 3px;
    margin-top: 3px;
    margin-right: 3px;
}

.hutong-group-item__foldout > .unity-toggle__input > .unity-toggle__checkmark {
    background-image: var(--hutong-editor-foldout-icon);
    background-size: 14px 14px;
    height: 14px;
    
}

.hutong-group-item__foldout > .unity-toggle__input:checked > .unity-toggle__checkmark {
    background-image: var(--hutong-editor-foldout-on-icon);
}

.hutong-group-item__foldout .unity-foldout__toggle--inspector {
    margin-left: 0;
}

.locked .hutong-group-item__foldout {
    margin-left: 0;
}

.editor-only-list-view .hutong-custom-list-view-item {
    background-color: rgb(56,56,56)
}

.hutong-custom-list-view-item--selected .hutong-action-titlebar {
    background-color: var(--hutong-editor-selected-item-color);
}

.hutong-custom-list-view-item--selected .hutong-action-titlebar:hover {
    background-color: var(--hutong-editor-selected-item-color);
}

.hutong-editor__toolbar-settings-menu {
    /*background-color: initial;*/
    background-image: var(--hutong-editor-settings-icon);
    border-width: 0;
    padding-top: 2px;
    padding-bottom: 2px;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    flex-shrink: 0;
    width: 16px;
    max-width: 16px;
    height: 16px;
    align-self: center;
}

.hutong-editor__toolbar-search-field {
    flex-grow: 1;
    flex-shrink: 1;
}

.hutong-editor__toolbar-add-button {
    background-image: var(--hutong-editor-add-icon);
    background-size: 16px 16px;
    width: 24px;
    flex-shrink: 0;
    margin-top: 0;
    margin-bottom: 0;
    border-left-width: 0;
}

.hutong-editor__toolbar-settings-menu > .unity-toolbar-menu__arrow {
    display: none;
}

.hutong-editor__settings-button {
    flex-shrink: 0;
    flex-grow: 0;
    background-color: transparent;
    background-image: var(--hutong-editor-settings-icon);
    width: 16px;
    max-width: 16px;
    height: 16px;
    border-width: 0;
    border-radius: 0;
    margin-right: 0;
    margin-left: 0;
    align-self: center;
}

.hutong-editor__help-button {
    background-color: transparent;
    background-image: var(--hutong-editor-help-icon);
    width: 16px;
    height: 16px;
    border-width: 0;
    border-radius: 0;
    margin-right: 0;
    margin-left: 0;
}

.hutong-icon-button {
    margin-left: 2px;
    margin-right: 2px;
    margin-top: 0;
    margin-bottom: 0;
    width: 16px;
    border-radius: 0;
    border-width: 0;
    background-color: transparent;
    flex-shrink: 0;
    background-size: 16px 16px;
}

.hutong-icon-button:hover {
    background-color: var(--hutong-icon-button-hover-color);
}

.hutong-settings-icon {
    background-image: var(--hutong-editor-settings-icon)
}

.unity-text-field__placeholder > .unity-base-text-field__input {
    color: rgb(100, 100, 100);
}

.hutong-editor-type-button {
    -unity-text-align: middle-left;
    padding-left: 18px;
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 0;
    padding-right: 16px;
    overflow: hidden;
    height: 19px;
}

.hutong-editor-type-button__icon {
    margin-left: -18px;
    background-size: 14px 14px;
    width: 18px;
}

.hutong-editor-type-button__dropdown-arrow {
    position: absolute;
    right: 2px;
    top: 2px;
}

.hutong-editor-error-text {
    color: var(--unity-colors-error-text);
}

.hutong-error-callout {
    background-color: var(--hutong-editor-colors-error-background);
    border-radius: 8px;
    padding: 8px;
    margin: 8px;
    margin-bottom: 0;
    -unity-text-align: middle-left;
}

.hutong-error-callout__title {
    -unity-font-style: bold;
}

.hutong-error-callout__description {
    margin-top: 4px;
    white-space: normal;
}

.hutong-editor-count {
    -unity-text-align: middle-right;
    width: 34px;
    justify-content: center;
    border-radius: 8px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 2px;
    margin-bottom: 2px;
    padding-right: 6px;
    color: var(--hutong-editor-colors-white);
    background-color: var(--hutong-editor-colors-used-count-background);
    height: 16px;
}

.hutong-editor-count--bar {
    color: transparent;
    border-radius: 4px;
    background-color: var(--hutong-editor-colors-white-dimmed);
    opacity: 0.2;
}

.hutong-editor-count--bar:hover {
    opacity: 1;
    color: var(--hutong-editor-colors-white);
    min-width: 24px;
}

.hutong-editor-count--zero {
    opacity: 0.3;
}

.hutong-lock-toggle {
    height: 100%;
    margin-top: 0;
    margin-bottom: 0; 
}

.hutong-lock-toggle > .unity-toggle__input > .unity-toggle__checkmark {
    background-image: var(--unity-icons-lock);
    height: 16px;
    width: 16px;
}

.hutong-lock-toggle > .unity-toggle__input:checked > .unity-toggle__checkmark {
    background-image: var(--unity-icons-lock-checked);
}

.hutong-short-label Label {
    width: 60px;
    min-width: 60px;
}

.hutong-editor-editable-label__hide-label {
    color: transparent;
}

.hutong-editor-editable-label__editor > TextField {
    margin-left: -2px;
    margin-right: -2px;
    padding: 0;
    flex-grow: 1;
}

.hutong-editor-editable-label__editor > TextField > TextInput {
    margin-left: 0;
    margin-right: 0;
    border-width: 0;
}

.hutong-editor-editable-label__editor > TextField > TextInput > TextElement {
    padding-right: 0;
}

.hutong-editable-label .unity-base-field__input {
    border-width: 0;
    background-color: transparent;
}

.hutong-editable-label:focus .unity-base-field__input {
    background-color: var(--unity-colors-default-background);
    flex-grow: 1;
}

/*
 IconStyleButton
 */

.hutong-icon-style-button {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin-left: 0;
    margin-right: 4px;
    border-radius: 4px;
}

.hutong-icon-style-button:hover {
    background-color: var(--unity-colors-button-background);
    -unity-background-image-tint-color: white;
}

.hutong-icon-style-button--icon {
    background-color: transparent;
    border-width: 0;
}


/*
CustomListView
*/

.hutong-custom-list-view {
    flex-grow: 1;
    /*background-color: rgba(0,0,0,0.1);*/
    /*background-color: var(--hutong-editor-colors-list-view-background);*/
    background-color: transparent;
}

.hutong-custom-list-view__blocker {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.hutong-custom-list-view__hover-bar {
    width: 100%;
}

.hutong-custom-list-view-item--placeholder {
    background-color: cyan;
    width: 100%;
}

.hutong-custom-list-view-item {
    background-color: var(--hutong-editor-colors-list-item-background);
    flex-direction: row;
    flex-grow: 1;
    border-bottom-width: 1px;
    border-bottom-color: var(--hutong-editor-colors-list-item-border_accent);
    /*border-bottom-color: var(--unity-colors-toolbar-border);*/
}

/*
.hutong-custom-list-view-item--first {
    border-top-width: 1px;
    border-top-color: var(--unity-colors-inspector_titlebar-border_accent);
}*/

.hutong-custom-list-view-item:hover {
    background-color: var(--unity-colors-inspector_titlebar-background-hover);
}

/* Keep locked rows visually identical while interactions are disabled via SetEnabled(false). */
.hutong-custom-list-view-item.locked :disabled {
    opacity: 1;
}

.hutong-controls-list-view {
    margin-top: 0;
    background-color: transparent;
}

.hutong-controls-list-view VariableVarField {
    padding-left: 1px;
}

.hutong-controls-list-view DebugValueField {
    margin-left: -2px;
}

.hutong-controls-list-view VariableRefField {
    padding-left: 1px;
}

.hutong-controls-list-view EventRefField {
    padding-left: 1px;
}

.hutong-controls-list-view CommentItemField {
    margin-left: 1px;
}

.locked {
    border-bottom-color: var(--unity-colors-window-background);
    border-top-color: initial;
}

/*
.hutong-custom-list-view-item PropertyField {
    flex-grow: 1;
    margin-left: 0;
    padding-left: 0;
}*/

/*
ActionParameters > PropertyField {
    flex-grow: 1;
    margin-left: 0;
    padding-left: 0;
    margin-left: 5px;
}*/

.hutong-custom-list-view-item > PropertyField {
    flex-grow: 1;
}

ActionParameters > PropertyField {
    flex-grow: 1;
}

.hutong-custom-list-view-item__drag-handle {
    width: 10px;
    height: 4px;
    margin: 0 4px 0 4px;
    align-self: center;
    border-width: 1px 0;
    border-color: var(--hutong-editor-colors-drag-handle);
}

.hutong-custom-list-view-item__delete-button {
    width: 19px;
    height: 19px;
    margin: 0 4px 0 0;
    align-self: center;
    margin-top: 2px;
    background-image: var(--hutong-editor-delete-icon);
    background-color: transparent;
    border-color: transparent;
}

.hutong-custom-list-view-item__delete-button:hover {
    background-color: var(--unity-colors-button-background);
}

.hutong-custom-list-view-item--selected {
    background-color: var(--hutong-editor-selected-item-color)
}

.hutong-custom-list-view-item--selected:hover {
    background-color: var(--hutong-editor-selected-item-color)
}

.hutong-custom-list-view-item .unity-base-field__inspector-field {
    margin-right: 2px;
}

/*
TabView
*/

.hutong-pages__page {
    position: absolute;
}

.hutong-tab-view {
    flex-grow: 1;
}

.hutong-tab-view__tab-bar {
    flex-direction: row;
    border-width: 0;
    border-color: var(--unity-colors-inspector_titlebar-border_accent);
    height: 24px;
    align-items: center;
}

.hutong-tab-view__tab {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 0;
    padding: 2px 6px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--unity-colors-button-border_accent);
    background-color: var(--unity-colors-tab-background);
    border-top-width: 2px;
    border-top-color: transparent;
    opacity: 0.8;
}

.hutong-tab-view__tab:hover {
    background-color: var(--unity-colors-tab-background-hover);
}

.hutong-tab-view__tab--selected, .hutong-tab-view__tab--selected:hover {
    background-color: var(--unity-colors-toolbar-background);
    border-top-color: var(--unity-colors-highlight-background);
    border-bottom-color: transparent;
    border-radius: 2px;
    border-top-width: 2px;
    opacity: 1;
}


.hutong-tab-view__tab-icon {
    background-size: 14px 14px;
    width: 14px;
    display: none;
}

.hutong-tab-view__tab-title {
    margin-left: 3px;
    -unity-text-align: middle-center;
    overflow: hidden;
    text-overflow: ellipsis;
}

.hutong-tab-view__content-container {
    flex-grow: 1;
}

/*
Foldout Header
 */

.hutong-foldout-header {
    margin-top: 5px;
    flex-shrink: 1;
}

.hutong-foldout-header > .unity-foldout__content {
    margin-left: 2px;
    min-height: 30px;
    margin-top: 4px;
    margin-bottom: 8px;
}

.hutong-foldout-header > Toggle {
    background-color: var(--hutong-editor-colors-header-background);
    padding-left:2px;
    padding-top: 3px;
    padding-bottom: 3px;
    margin-bottom: 0;
    margin-right: 0;
}

.hutong-foldout-header > .unity-foldout__toggle--inspector {
    margin-left: 0;
}

.hutong-foldout-header > .unity-foldout__toggle {
    border-bottom-color: var(--hutong-editor-colors-header-border_accent);
    border-bottom-width: 1px;
}

.hutong-foldout-header__icon {
    margin-left: 3px;
    margin-right: 5px;
}

.hutong-foldout-header__controls {
    position: absolute;
    right: 2px;
    top: 3px;
    height: 18px;
    flex-direction: row-reverse;
}

/*
Node Inspector
 */

.hutong-fsm-selection-toolbar {
    height: 24px;
}

.hutong-node-inspector {
    flex-grow: 1;
}

.hutong-node-inspector > .hutong-node-inspector-header {
    padding-left: 4px;
}

FsmEditorInspector  .hutong-node-inspector-header {
    max-height: 50%;
    overflow: hidden;
}

.hutong-node-inspector-header {
    flex-shrink: 0;
    margin: 0;
    border-left-width: 2px;
    padding: 4px;
    padding-left: 1px;
    padding-right: 0;
    padding-top: 6px;
}

.hutong-node-inspector-header .markdown-empty-hint {
    opacity: .6;
}

.hutong-node-inspector-header__title-row {
    flex-shrink: 0;
    padding-left: 1px;
}

.hutong-node-inspector-header__name {
    flex-grow: 1;
    font-size: 14px;
    margin-top: 0;
    margin-left: 0;
}

.hutong-node-inspector-header__edit-button {
    display: none;
    margin-right: 0;
}

.hutong-node-inspector-header__settings-button {
    background-image: var(--hutong-editor-settings-icon);
    border-radius: 2px;
    width: 18px;
    border-width: 0;
    background-color: transparent;
}

.hutong-node-inspector-header__template-selector {
    margin-bottom: 7px;
    margin-left: -2px;
    margin-right: 1px;
}

.hutong-node-inspector-header__use-template .unity-object-field-display {
    display: none;
}

.hutong-node-inspector-header__description {
    margin-top: 8px;
    margin-bottom: 8px;
    margin-left: 2px;
    flex-shrink: 1;
    white-space: normal;
}

.hutong-node-inspector-header__errors-panel {
    margin-left: -6px;
}

.hutong-prefab-panel {
    flex-grow: 0;
    flex-shrink: 1;
    margin: 8px;
    margin-left: 0;
    padding-left: 8px;
    padding-bottom: 0;
    border-left-width: 2px;
    border-left-color: var(--hutong-editor-colors-prefab-override);
}

.hutong-events-editor__prefab-panel {
    max-height: 200px;
}

.hutong-variables-editor__prefab-panel {
    max-height: 200px;
}

.hutong-prefab-panel__title {
    flex-direction: row;
    min-height: 20px;
    align-items: center;
    margin-bottom: 4px;
}

.hutong-prefab-panel__foldout {
    width: 13px;
    min-width: 13px;
    margin-right: 2px;
    margin-left: -3px;
    flex-shrink: 0;
}

.hutong-prefab-panel__foldout > .unity-toggle__input > .unity-toggle__checkmark {
    background-image: var(--hutong-editor-foldout-icon);
}

.hutong-prefab-panel__foldout > .unity-toggle__input:checked > .unity-toggle__checkmark {
    background-image: var(--hutong-editor-foldout-on-icon);
}

.hutong-prefab-panel__title > Label {
    flex-grow: 1;
}

.hutong-prefab-panel__help-button {
    margin-left: 4px;
    margin-right: -2px;
    align-self: flex-start;
}

.hutong-prefab-panel__note {
    margin-top: 8px;
    white-space: normal;
    -unity-font-style: bold;
}

.hutong-prefab-panel__list {
    max-height: 200px;
    flex-grow: 0;
}

.hutong-prefab-panel__buttons {
    margin-top: 8px;
    margin-left: -3px;
    flex-direction: row;
    flex-shrink: 0;
}

.hutong-node-description__label {
    white-space: normal;
    width: auto;
}

.hutong-node-inspector-header__color-button {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-right: 1px;
}

.hutong-node-inspector-header__icon-button {
    background-size: 17px 17px;
    flex-grow: 1;
    flex-shrink: 0;
    margin-left: 0;
    margin-right: 0;
}

.hutong-state-inspector NodeInspectorHeader {
    background-color: var(--unity-colors-toolbar-background);
}

.hutong-state-inspector__pages {
    flex-grow: 1;
    flex-shrink: 0;
}

ActionsListView .unity-scroll-view__content-viewport {
    padding-bottom: 20px;
}

/*
 Missing Global Variable/Event Field
 */

.hutong-missing-global-field__error {
    margin-left: 3px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.hutong-missing-global-editor {
    padding: 10px;
}

.hutong-missing-global-editor__title {
    -unity-font-style: bold;
    margin-top: 5px;
    margin-bottom: 5px;
    flex-grow: 1;
}


.hutong-missing-global-editor__info {
    margin-top: 16px;
    margin-bottom: 16px;
    flex-grow: 1;
    opacity: 0.6;
    white-space: normal;
    flex-wrap: wrap;
}

.hutong-missing-global-editor__object-field {
    margin-top: 5px;
    flex-grow: 1;
    margin-left: 0;
    margin-right: 0;
}


.hutong-missing-global-editor__object-field  .unity-label {
    width: 100px;
    min-width: 40px;
}

/*
 Fields
 */

.hutong-fields {
    -unity-font-style: normal;
    padding-bottom: 10px;
    padding-top: 10px;
    padding-left: 0;
    padding-right: 2px;
    flex-shrink: 0;
}

.hutong-fields > PropertyField > StateSelectorField {
    padding-left: 0;
    border-left-width: 0;
}

/*
.hutong-fields > PropertyField {
    padding-left: 9px;
}*/

.hutong-fields > ListView {
    padding-left: 6px;
    margin-right: 3px;
    margin-bottom: 3px;
}

.hutong-fields > ListView > Foldout > Toggle{
    margin-bottom: 3px;
}

.hutong-field {
    margin-left: 0;
    border-left-width: 2px;
    border-left-color: transparent;
    padding-left: 9px;
    margin-bottom: 2px;
}

.hutong-field > .unity-decorator-drawers-container {
    margin-left: 0;
}

.hutong-field > .unity-decorator-drawers-container > .unity-header-drawer__label{
    margin-top: 7px;
    margin-bottom: 5px;
}

.hutong-field__browse-button {
    width: 20px;
    margin: 0;
    margin-left: 2px;
}

.hutong-property-field {
    padding-left: 9px;
    margin-top: 0;
    margin-bottom: 2px;
}

.hutong-field__header {
    margin-top: 7px;
    margin-bottom: 5px;
    -unity-font-style: bold;
    /*wide margin-left: 20px;*/
    margin-left: 11px;
}

.hutong-field__note {
    /*wide margin-left: 20px;*/
    margin-left: 11px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.hutong-field-error {
    background-color: var(--hutong-editor-colors-error-background);
    border-left-color: red;
}

.hutong-field-error__label {
    padding-top: 3px;
    padding-bottom: 3px;
}

.hutong-field > .unity-base-field
{
    margin-left: 0;
}

.hutong-field > PropertyField > .unity-base-field
{
    margin-left: 0;
}

.hutong-field > Label
{
    /*wide margin-left: 9px;*/
    width: 40%;
    min-width: 40px;
}

.hutong-field > .unity-base-field > Label
{
    /*wide margin-left: 9px;*/
    width: 40%;
    min-width: 40px;
}

.hutong-field > .hutong-enum-flags-field > Label
{
    /*wide margin-left: 9px;*/
    width: 40%;
    min-width: 40px;
}

/*
Variable Reference
 */

.hutong-variable-ref-field {
    min-height: 19px;
    flex-direction: row;
    margin-bottom: 2px;
    margin-right: 2px;
    padding-left: 9px;
}

.hutong-variable-ref-field__input {
    min-width: 100px;
}

.hutong-variable-ref-field__label {
    width: 40%;
    min-width: 40px;
}

.hutong-variable-ref-dropdown {
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 1px;
}

.hutong-variable-ref-dropdown--is-write-only {
    background-image: var(--hutong-editor-write-only-icon);
    width: 14px;
    height: 14px;
    align-self: center;
    opacity: 0.5;
    margin-left: -16px;
    margin-right: 2px;
    right: 0;
}

.hutong-event-reference-field--send-event {
    background-image: var(--hutong-editor-send-event-icon);
    width: 14px;
    height: 14px;
    align-self: center;
    opacity: 0.5;
    margin-left: -16px;
    margin-right: 2px;
    right: 0;
}

.hutong-variable-var-field {
    min-height: 19px;
    flex-direction: row;
}

.hutong-variable-var-field Slider {
    margin-left: 0;
    margin-right: 0;
}

.hutong-variable-var-field SliderInt {
    margin-left: 0;
    margin-right: 0;
}

.hutong-variable-var-field Slider > Label {
    width: 40%;
    /*wide margin-left: 9px;*/
    margin-right: 10px;
}

.hutong-variable-var-field SliderInt > Label {
    width: 40%;
    /*wide margin-left: 9px;*/
    margin-right: 10px;
}

.hutong-variable-var-field__value-field {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
}

/* Not sure why this was needed (InputAction UI?)
.hutong-variable-var-field__value-field > IMGUIContainer {
    margin-left: -18px;
    margin-right: -3px;
}*/

.hutong-prefab-override {
    border-left-width: 2px;
    border-left-color: var(--hutong-editor-colors-prefab-override);
}

.unity-binding__prefab-override-bar-not-applicable {
    opacity: 1;
}

/* hide in Unity Inspector, because it has it's own prefab override indicators*/
.unity-inspector-element__custom-inspector-container .hutong-prefab-override {
    border-left-color: transparent;
}

.unity-inspector-element__custom-inspector-container .fsm-component-editor__title-row.hutong-prefab-override {
    border-left-color: var(--hutong-editor-colors-prefab-override);
}

.hutong-variable-var-field__value-field > Foldout{
    margin-left: -4px;
}

/*wide
.hutong-variable-reference-field__label--hidden > .unity-base-field__input {
    margin-left: 9px;
}*/

/*
.hutong-variable-ref-field .hutong-variable-reference-field__label{
    margin-right: 10px;
}
*/

.hutong-variable-var-field > PropertyField > DropdownField {
    min-height: 19px;
    margin-left: 2px;
    margin-right: 0;
    margin-top: 0;
}

.hutong-variable-var-field > PropertyField > DropdownField > Label {
    margin-right: 10px;
}

.hutong-variable-var-field > PropertyField > ListView > Foldout > Toggle {
    margin-bottom: 3px;
}

.hutong-variable-var-field > VariableRefDropdown {
    min-height: 19px;
}

.hutong-variable-var-field > VariableRefDropdown > Label {
    margin-right: 10px;
}

.hutong-variable-var-field > .unity-base-field  > .unity-property-field__label {
    margin-right: 10px;
    width: 40%;
    min-width: 40px;
}

.hutong-variable-var-field > PropertyField  > EnumField {
    margin-top: 0;
    margin-right: 0;
}

.hutong-variable-var-field > PropertyField  > EnumField > Label {
    /*wide margin-left: 9px;*/
    margin-right: 10px;
    width: 40%;
    min-width: 40px;
}

.hutong-variable-var-field > PropertyField  > EnumFlagsField > Label {
    /*wide margin-left: 9px;*/
    margin-right: 10px;
    width: 40%;
    min-width: 40px;
}

.hutong-enum-flags-field > .unity-base-field__input {
    margin-left: 9px;
}

.hutong-field > .hutong-enum-flags-field > .unity-base-field__input {
    margin-left: 0;
}

.hutong-variable-var-field__value-field > .hutong-enum-flags-field > .unity-base-field__input {
    margin-left: 0;
}

.hutong-variable-var-field .unity-property-field__input {
    min-height: 19px;
}

.hutong-variable-var-field__variable-toggle {
    background-image: var(--hutong-editor-variable-toggle-icon);
    flex-shrink: 0;
    margin: 0;
    margin-left: 2px;
    margin-right: 3px;
    padding: 0;
    width: 18px;
    height: 19px;
}

.hutong-variable-var-field__variable-toggle--on {
    background-color: var(--unity-colors-tab-background);
    /*background-size: 14px 14px;*/
    /*
    background-size: 16px 16px;
    border-color: rgb(20,20,20);*/
}

.hutong-variable-var-field > Toggle {
    height: 17px;
    align-items: center;
}


.hutong-impulse-channel-mask-field__input > Button {
    margin: 0;   
}

/*
EventRefField
 */

.hutong-event-reference-field__label {
    width: 40%;
    min-width: 40px;
}

/*
.hutong-event-data-setter-editor__override {
    margin-left: 10px;
}*/

.hutong-event-data-getter-editor > .hutong-debug-value-field {
    margin-left: 5px;
}

.hutong-event-data-setter-editor {
    flex-grow: 1;
    flex-shrink: 0;
    margin-left: 0;
    padding-bottom: 4px;
    /*border-bottom-width: 1px;
    border-color: var(--hutong-editor-list-view-background-color);*/
}

.hutong-event-data-setter-editor .hutong-variable-ref-dropdown__label {
    margin-right: 0;
}

.hutong-event-data-setter-editor__icon {
    align-self: flex-start;
    width: 14px;
    height: 14px;
    margin-top: 2px;
    margin-bottom: 1px;
}

.hutong-event-data-setter-editor__override {
    flex-grow: 1;
    margin-left: 0;
    padding-left: 0;
}

.hutong-event-data-setter-editor__override > .hutong-variable-var-field__value-field > .unity-base-field__label {
    margin-right: 1px;
}

/*
ActionListEditor
 */

.hutong-action-list-editor {
    border-width: 0;
    border-top-color: var(--unity-colors-default-border);
    border-top-width: 1px;
}

.hutong-action-list-editor > FoldoutHeader {
    flex-grow: 1;
}

.hutong-action-list-editor > FoldoutHeader > .unity-foldout__content {
    flex-grow: 1;
}


.hutong-action-list-editor__footer {
    border-top-color: var(--unity-colors-default-border);
    border-top-width: 1px;
    flex-direction: row;
    flex-shrink: 0;
    justify-content: center;
    padding-top: 5px;
    padding-bottom: 5px;
}

.hutong-action-list-editor__add-action {
    flex-grow: 1;
    max-width: 100px;
    flex-shrink: 0;
    height: 20px;
    min-height: 20px;
    margin-right: 0;
}

.hutong-action-list-editor__browse-actions {
    width: 20px;
    flex-shrink: 0;
    height: 20px;
    margin-left: 0;
    background-image: var(--hutong-editor-search-jump-icon);
    background-size: 18px 18px;
}

.hutong-variable-ref-field__dropdown {
    margin-left: 2px;
}

.hutong-ref-dropdown {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
}

.hutong-variable-var-field > .hutong-type-reference-field > .hutong-ref-dropdown {
    margin-left: 0;
    margin-right: 0;
}

.hutong-variable-var-field > .hutong-type-reference-field > .hutong-ref-dropdown > .hutong-type-reference-field__label {
    margin-right: 10px;
}

.hutong-ref-dropdown__label {
    /*wide margin-left: 9px;*/
    width: 40%;
    min-width: 40px;
    height: 17px;
}

.hutong-ref-dropdown__input {
    padding-left: 0;
}

.hutong-ref-dropdown__input-label {
    padding-left: 3px;
    align-self: center;
    flex-shrink: 1;
}

.hutong-ref-dropdown__icon {
    margin-top: 1px;
    margin-left: 1px;
    margin-right: 0;
    padding: 0;
    padding-left: 2px;
    width: 14px;
    height: 14px;
    align-self: center;
    flex-shrink: 0;
}

.hutong-ref-dropdown__right-aligned {
    position: absolute;
    right: 18px;
    top: 0;
    bottom:0;
    flex-direction: row-reverse;
}

.hutong-editor-button-icon {
    width: 14px;
    height: 14px;
    align-self: center;
    margin-right: 2px;
    flex-shrink: 0;
}

.hutong-ref-dropdown__global-icon {
    background-image: var(--hutong-editor-global-icon);
    opacity: 0.5;
}

.hutong-event-selector-field__input-label {
    text-overflow: ellipsis;
    /*-unity-text-overflow-position: start;*/
}

.hutong-event-selector-field__event-data-icon {
    background-image: var(--hutong-editor-event-data-icon);
    opacity: 0.25;
}

.hutong-state-selector-field__input-label {
    text-overflow: ellipsis;
    -unity-text-overflow-position: start;
    /*text-shadow: 0 1px 1px rgba(0, 0, 0, 0.27);*/
}



/*
Action Editor
 */


.hutong-action-editor {
    flex-grow: 1;
}

.hutong-action-editor--disabled {
    opacity: 0.5;
}

.hutong-field-info-label {
    flex-grow: 1;
    flex-shrink: 0;
    padding: 2px;
    padding-left: 5px;
    padding-right: 5px;
    margin-left: 9px;
    margin-right: 3px;
    margin-bottom: 2px;
    background-color: var(--hutong-editor-colors-debug-value-background);
    color: var(--hutong-editor-colors-debug-value-text-color);
    overflow: hidden;
    min-height: 14px;
    border-radius: 4px;
}

.hutong-field-info-label--error {
    background-color: var(--hutong-editor-colors-error-background);
    color: var(--unity-colors-default-text);
}

.hutong-action-debug-info  {
    background-color: var(--unity-colors-window-background);
}

.hutong-action-debug-info__info {
    margin-top: 4px;
    margin-left: 8px;
    margin-right: 6px;
    margin-bottom: 4px;
    background-color: var(--hutong-editor-colors-debug-value-background);
    border-radius: 4px;
}

.hutong-action-debug-info__info > .unity-base-text-field__input {
    padding: 8px;
    background-color: transparent;
    color: var(--hutong-editor-colors-debug-value-text-color);
    border-width: 0;
    white-space: normal;
}

.hutong-debug-value-field {
    margin-left: 4px;
}

.hutong-debug-value-field__label {
    flex-grow: 1;
    flex-shrink: 0;
    align-self: stretch;
    /*wide margin-left: 15px;*/
    margin-left: 2px;
    margin-right: 3px;
    margin-bottom: 2px;
    padding: 2px;
    /*wide padding-left: 2px;*/
    padding-left: 6px;
    padding-right: 5px;
    background-color: var(--hutong-editor-colors-debug-value-background);
    color: var(--hutong-editor-colors-debug-value-text-color);
    overflow: hidden;
    min-height: 14px;
    border-radius: 4px;
    -unity-text-align: middle-left;
}

.hutong-debug-value-field__error {
    background-color: var(--hutong-editor-colors-error-background);
    color: var(--unity-colors-default-text);
}

.hutong-fields .hutong-debug-value-field {
    margin-bottom: 4px;
}

/*
.hutong-action-parameters .hutong-debug-value-field__label {
    background-color: transparent;
    border-color: var(--hutong-editor-colors-debug-value-background);
    color: var(--hutong-editor-colors-text-dimmed);
    border-left-width: 1px;
    border-bottom-width: 1px;
    border-radius: 0;
    border-bottom-left-radius: 8px;
    padding-bottom: 4px;
}*/

.hutong-debug-value-field__label--changed {
    opacity: 1;
    color: var(--hutong-editor-colors-debug-value-text-color_active);
}

.hutong-debug-value-field__label--idle  {
    transition: color;
    transition-duration: 0.5s;
    color: var(--hutong-editor-colors-debug-value-text-color);
}

.hutong-debug-value-field__label--idle-no-animation  {
    opacity: 0.5;
    color: white;
}

.hutong-ease-curve-drawer__preview-curve{
    /*wide margin: 20px;*/
    margin: 5px;
    margin-left: 11px;
    height: 30px;
    background-color: var(--hutong-editor-list-view-background-color);
}

.hutong-action-editor__list-view {
    margin-right: 3px;
    margin-bottom: 5px;
}

/*
.hutong-action-editor__list-view > Foldout > Toggle {
    visibility: hidden;
}*/

.hutong-notes-inspector {
    margin: 8px;
}

.hutong-comment-inspector {
    margin: 8px;
}

.hutong-comment-inspector__style-row {
    flex-direction: row;
    flex-shrink: 0;
}

.hutong-comment-inspector__style-row > ColorField {
    flex-grow: 1;
    flex-shrink: 1;
    max-width: 100px;
    margin-right: 0;
}

.hutong-comment-inspector__style-row > ColorField > Label {
    min-width: 40px;
}

.hutong-markdown-text-field {
    min-height: 20px;
    flex-shrink: 1;
    white-space: normal;
}

.hutong-markdown-help-button {
    width: 150px;
    flex-shrink: 0;
}

.hutong-info-box {
    /*color: var(--hutong-editor-colors-text-dimmed);*/
    margin: 2px;
    border-radius: 8px;
    background-color: var(--hutong-log-colors-background);
    padding: 8px;
    opacity: 0.6;
}

.hutong-action-info-box {
    padding-left: 46px;
    border-radius: 8px;
    -unity-text-align: middle-left;
    margin-top: 3px;
    margin-bottom: 10px;
    margin-left: 9px;
    margin-right: 3px;
    opacity: 0.5;
    flex-direction: row;
    flex-shrink: 0;
    overflow: hidden;
}

.hutong-action-info-box > Image {
    margin: 4px;
    margin-left: -40px;
    width: 32px;
    height: 32px;
    margin-right: 5px;
    flex-shrink: 0;
    align-self: center;
}

.hutong-action-info-box > Label {
    white-space: normal;
    padding-top: 10px;
    padding-bottom: 10px;
}

.hutong-auto-fix-button {
    margin-left: 5px;
    background-color: var(--hutong-editor-colors-error-background);
    cursor: arrow-plus;
    opacity: 1;
    border-width: 1px;
    border-color: transparent;
}

.hutong-auto-fix-button:hover {
    border-color: var(--unity-colors-button-border);
    border-bottom-color: var(--unity-colors-button-border_accent);
}

.hutong-auto-fix-button__icon {
    margin-left: -40px;
    width: 32px;
    height: 32px;
    margin-right: 5px;
    flex-shrink: 0;
}

.hutong-action-error {
    background-color: var(--hutong-editor-colors-error-background);
    opacity: 1;
}

.hutong-missing-action {
    flex-grow: 1;
    margin-top: 5px;
    margin-left: 5px;
    margin-right: 5px;
}

.hutong-fields .unity-property-field__label {
    /*
    width: 40%;
    min-width: 50px;*/
    overflow: hidden;
}

.hutong-fields .unity-popup-field__label {
    width: 40%;
    min-width: 40px;
}

.hutong-action-editor__content {
    background-color: var(--unity-colors-window-background);
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    overflow: hidden;
    flex-shrink: 0;
}

.hutong-action-editor__content > HelpBox {
    flex-shrink: 0;
}

.hutong-action-editor__inline-description {
    margin-left: 11px;
    margin-top: 8px;
    margin-bottom: 8px;
    margin-right: 8px;
    white-space: normal;
    opacity: 0.6;
}

.hutong-action-editor__tools-container {
    background-color: transparent;
    flex-direction: row;
    flex-shrink: 1;
    flex-grow: 0;
    opacity: 0.8;
    border-radius: 8px;
    margin-top: 10px;
    margin-bottom: 10px;
    margin-left: 3px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 10px;
    padding-right: 10px;
    border-width: 1px;
    border-color: rgba(0,0,0,0.2);
    height: 26px;
}

.hutong-action-editor__tools-container:hover {
    opacity: 1;
    border-color: rgba(255, 255, 255, 0.1);
}

.hutong-action-editor__config {
    background-image: resource('d__Popup.png');
    -unity-background-scale-mode: scale-to-fit;
    max-width: 32px;
}

.hutong-action-editor__summary {
    margin-left: 9px;
    margin-top: 16px;
    margin-bottom: 16px;
}

.hutong-action-editor__tools {
    flex-direction: row;
    height: 20px;
    border-radius: 4px;
    margin-top: 10px;
    margin-left: 6px;
    margin-right: 3px;
    padding-left: 2px;
    align-items: center;
}

.hutong-action-editor__scene-tools {
    flex-shrink: 0;
}

.hutong-action-editor__scene-tools-button {
    flex-direction: row;
    border-radius: 8px;
    height: 20px;
    width: 110px;
    padding-left: 15px;
    align-items: center;
    opacity: 0.5;
    margin: 0;
}

.hutong-action-editor__scene-tools--active {
    opacity: 1;
    border-width: 2px;
    border-color: var(--hutong-editor-selected-item-color);
}

.hutong-action-editor__scene-tools-icon {
    position: absolute;
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    margin-left: -10px;
    background-color: transparent;
    background-image: resource('Icons/SceneGizmo');
    opacity: 0.6;
}

.hutong-action-editor__action-blocks-button {
    width: 18px;
    height: 19px;
    flex-shrink: 0;
    border-radius: 3px;
    background-image: var(--hutong-editor-action-blocks-icon);
}

/*
.hutong-action-editor--active #action-label {
    color: rgb(0, 255, 36);
}

.unity-editor--paused #action-label {
    color: rgb(255, 255, 36);
}
*/

.hutong-action-editor--active .hutong-action-titlebar__enabled .unity-toggle__checkmark {
    -unity-background-image-tint-color:  var(--hutong-editor-colors-play);
    /*background-image: var(--hutong-editor-action-play-icon);*/
}

.hutong-action-editor--paused .hutong-action-titlebar__enabled .unity-toggle__checkmark {
    -unity-background-image-tint-color:  var(--hutong-editor-colors-paused);
    /*background-image: var(--hutong-editor-action-play-icon);*/
}

.hutong-action-editor--active {
    opacity: 1;
}

.hutong-action-editor__spacer {
    height: 24px;
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.2);
    background-color: var(--hutong-editor-colors-list-spacer);
    background-size: 16px 16px;
}

.hutong-action-editor__spacer--disabled {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.15);
}

/*
.hutong-custom-list-view-item--dragging .hutong-action-editor__spacer {
    display: none;
    height: 0;
    max-height: 0;
}*/

.hutong-action-editor__blocking {
    background-image: var(--hutong-editor-blocking-icon);
}

.hutong-action-editor__loop-start {
    /*background-image: var(--hutong-editor-loop-top-icon);*/
    height: 8px;
}

.hutong-action-editor__loop-end {
    background-image: var(--hutong-editor-loop-bottom-icon);
    background-size: 24px 18px;
    height: 24px;
}

.hutong-action-editor__loop-skip {
    background-image: var(--hutong-editor-loop-skip-icon);
    background-size: 18px 18px;
    height: 24px;
}

.hutong-action-editor__loop-stop {
    background-image: var(--hutong-editor-loop-stop-icon);
    background-size: 24px 18px;
    height: 24px;
}

.hutong-action-editor__looping {
    background-image: var(--hutong-editor-looping-icon);
}

.error {
    border-left-width: 2px;
    border-left-color: rgba(255, 0, 0, 0.59);
    margin-left: -3px;
    background-color: rgba(255, 0, 0, 0.16);
}

.error-icon {
    background-image: var(--unity-icons-console_entry_error_small);
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin-right: 3px;
}

.hutong-action-editor--finished #action-label {
    color: var(--unity-colors-default-text);
    transition-property: all;
    transition-duration: 1s;
    transition-timing-function: ease-in-sine;
}

.hutong-action-editor--finished {
    opacity: var(--hutong-finished-action-opacity);
    transition-property: all;
    transition-duration: 0.5s;
    transition-timing-function: ease-in-sine;
}

.hutong-action-editor--inactive {
    opacity: var(--hutong-finished-action-opacity);
}

.hutong-action-progress-bar-bg {
    background-color: var(--unity-colors-default-background);
    position: absolute;
    height: 4px;
    bottom: -1px;
    left: 4px;
    right: 4px;
    border-left-width: 1px;
    border-right-width: 1px;
    margin-left: 0;
}

.hutong-action-progress-bar {
    background-color: rgb(0, 183, 41);
    position: absolute;
    height: 2px;
    top: 1px;
}

.running {
    color: rgb(0, 202, 74);
}

.unity-editor--paused .hutong-action-progress-bar {
    background-color: rgb(255, 255, 36);
}

.hutong-action-titlebar__button {
    background-color: rgba(0,0,0,0);
    border-width: 0;
    border-radius: 2px;
    width: 18px;
    height: 18px;
    margin: 0;
    margin-left: 2px;
    margin-right: 2px;
}

.hutong-action-titlebar__button:hover {
    background-color: var(--hutong-icon-button-hover-color);
}

.hutong-action-titlebar__debug-action {
    background-image: var(--hutong-editor-debug-watch-icon);
    display: none;
    opacity: 1;
}

.hutong-action-titlebar:hover > .hutong-action-titlebar__debug-action {
    display: flex;
}

.hutong-action-titlebar__swap-action {
    background-image: var(--hutong-editor-swap-action-icon);
    display: none;
}

.hutong-action-titlebar:hover > .hutong-action-titlebar__swap-action {
    display: flex;
}

.hutong-action-titlebar__help-button {
    background-image: var(--hutong-editor-help-icon);
    display: none;
}

.hutong-action-titlebar:hover > .hutong-action-titlebar__help-button {
    display: flex;
}

.hutong-update-mode {
    background-size: 16px 16px;
}

.hutong-action-titlebar__update-mode--disabled {
    opacity: 0.15;
}

.hutong-update-mode--late {
    -unity-background-image-tint-color: var(--hutong-editor-late-update-color);
}

.hutong-update-mode--on-animator-move {
    -unity-background-image-tint-color: var(--hutong-editor-on-animator-move-update-color);
}

.hutong-update-mode--fixed {
    -unity-background-image-tint-color: var(--hutong-editor-fixed-update-color);
}

.hutong-update-mode--loop {
    background-image: var(--hutong-editor-update-loop-icon);
}

.hutong-update-mode--once {
    background-image: var(--hutong-editor-update-once-icon);
}

.hutong-update-mode--event {
    background-image: var(--hutong-editor-update-event-icon);
}

.hutong-update-mode--blocking {
    background-image: var(--hutong-editor-blocking-update-icon);
}

.hutong-action-titlebar__settings-button {
    background-image: var(--hutong-editor-settings-icon);
}

.hutong-action-titlebar {
    flex-direction: row;
    height: 24px;
    align-items: center;
    flex-shrink: 0;
    border-bottom-color: var(--hutong-editor-colors-header-border_accent);
    background-color: var(--hutong-editor-colors-header-background);
    padding-left: 2px;
}

.hutong-action-titlebar:hover {
    background-color: var(--hutong-editor-colors-header-background-hover);
}

.hutong-action-editor--error > .hutong-action-titlebar {
    margin-left: 0;
    border-left-width: 2px;
    border-color: red;
    padding-left: 0;
}

.hutong-action-titlebar--error {
    margin-left: 0;
    border-left-width: 2px;
    border-color: red;
    padding-left: 0;
    /* Only final error location has background highlight */
    /*background-color: var(--hutong-editor-colors-error-background);*/
}


/*
.hutong-error .hutong-action-titlebar  {
    border-left-width: 2px;
    border-left-color: red;
}*/

.hutong-action-titlebar__expanded-toggle {
    flex-shrink: 0;
    width: 35px;

    margin-left: 2px;
}

.hutong-action-titlebar__expanded-toggle > .unity-toggle__input > .unity-toggle__checkmark {
    background-image: var(--hutong-editor-foldout-icon);
    height: 14px;
    width: 14px;
    margin-top: 1px;
}

.hutong-action-titlebar__expanded-toggle > .unity-toggle__input:checked > .unity-toggle__checkmark {
    background-image: var(--hutong-editor-foldout-on-icon);
}

.hutong-action-titlebar__enabled {
    flex-direction: row-reverse;
    margin-left: 2px;
    margin-right: 2px;
    margin-top: 0;
    margin-bottom: 0;
    width: 16px;
    height: auto;
}

.hutong-action-titlebar__icon {
    margin-right: 2px;
    margin-left: -22px;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

.hutong-action-titlebar__title {
    -unity-font-style: bold;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
    flex-grow: 1;
    flex-shrink: 1;
}

.hutong-action-titlebar__summary {
    -unity-font-style: bold;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
    flex-grow: 1;
    flex-shrink: 1;
    align-items: center;
}

.hutong-action-titlebar--selected {
    background-color: var(--unity-colors-highlight-background);
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-inspector_titlebar-border);
    border-left-color: var(--unity-colors-inspector_titlebar-border);
    border-right-color: var(--unity-colors-inspector_titlebar-border);
}

.unity-imgui-container {
    margin-left: 1px;
}

.variable-toggle-selected {
    background-color: var(--unity-colors-button-background-pressed);
}

.hutong-update-mode-button__update-once-icon {
    background-image: resource('Icons/UpdateMode/once');
    height: 16px;
}

.hutong-update-mode-button__update-loop-icon {
    background-image: resource('Icons/UpdateMode/loop');
    height: 16px;
}

.hutong-update-mode-button__update-disabled-icon {
    background-image: resource('Icons/UpdateMode/disabled');
    height: 16px;
}

.hutong-update-mode-button__update-late-icon {
    background-image: resource('Icons/UpdateMode/late');
    height: 4px;
}

.hutong-update-mode-button__update-fixed-icon {
    background-image: resource('Icons/UpdateMode/fixed');
    height: 4px;
}

/*
  List Editor
 */

.hutong-list-editor-panel {
    flex-grow: 1;
}


.hutong-list-editor-panel__list-view-panel {
    min-height: 60px;
}

.hutong-list-editor-panel__inspector-panel {
    background-color: var(--unity-colors-toolbar-background);
}


/*
 PlayMode GUI
 */

.hutong-fsm-play-mode-gui {
    margin-top: 10px;
    background-color: rgba(0,0,0,0.25);
    padding: 5px;
    border-radius: 5px;
    display: none;
}

.hutong-fsm-play-mode-gui--active {
    color: var(--hutong-editor-colors-debug-value-text-color_active);
}

.hutong-fsm-play-mode-gui--paused {
    color: var(--hutong-editor-colors-paused);
}

.hutong-fsm-play-mode-gui__status {
    margin-top: 3px;
    white-space: normal;
}

.unity-editor--playing > .hutong-fsm-play-mode-gui {
    display: flex;
}

/*
 Inspector Windows
 */

.hutong-inspector-window__header {
    background-color: var(--unity-colors-inspector_titlebar-background);
    border-bottom-color: var(--unity-colors-toolbar-border);
    border-bottom-width: 1px;
    padding-bottom: 6px;
    margin-bottom: 0;
    margin-left:  0;
    margin-right: 0;
}


/*
 Unity help box
 */

.unity-help-box {
    padding: 10px;
    border-width:0;
}

.unity-help-box__icon {
    margin-right: 10px;
}

.unity-help-box__label {
    font-size: 12px;
    opacity: 0.75;
}

/*
 Annotation Items
 */

/*
.hutong-note-item {
    margin-top: 8px;
    margin-bottom: 8px;
    margin-left: 4px;
    margin-right: 4px;
}*/

.hutong-comment-item {
    margin: 8px;
    margin-left: 11px;
}

.hutong-comment-item--text-only {
    opacity: 0.6;
}

.hutong-fsm-controls-editor {
    margin-left: -14px;
}

.hutong-fsm-controls-editor  .unity-foldout__toggle--inspector {
    margin-left: 0;
}

.hutong-fsm-controls-editor > .unity-foldout > .unity-foldout__content {
    margin-left: 14px;
}

.hutong-fsm-controls-editor .hutong-comment-item {
    margin-left: 3px;
}

.hutong-controls-list-view .hutong-comment-item {
    margin-left: 3px;
}

FsmEditor .hutong-controls-list-view .hutong-comment-item {
    margin-left: 3px;
}

.hutong-fsm-controls-editor .hutong-comment-item > UnityMarkdownField {
    margin-left: 0;
}

.hutong-custom-list-view-item--selected > PropertyField > CommentItemField > IconStyleButton {
    display: flex;
}

.hutong-custom-list-view-item--selected > PropertyField > GroupItemField > IconStyleButton {
    display: flex;
}

.hutong-group-item-editor {
    flex-direction: row;
    align-items: center;
    /*margin-left: 20px;*/
    padding-left: 6px;
    flex-grow: 1;
    flex-shrink: 1;
}

.hutong-group-item-editor__name {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 0;
}

/*
 Variable Field
 */

.hutong-variable-field {
    flex-direction: row;
    align-items: center;
    padding-left: 2px;
    padding-right: 4px;
    padding-top: 2px;
    padding-bottom: 1px;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 25px;
}

.hutong-variable-field__icon {
    margin-left: 4px;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

.hutong-variable-field__name {
    margin-left: 4px;
    width: 30%;
    overflow: hidden;
}

.hutong-variable-field .unity-toggle:hover {
    background-color: transparent;
}

.hutong-variable-field PropertyField:hover {
    background-color: transparent;
}

.hutong-variable-field__global-variable > .unity-base-field > .unity-base-field__label {
    margin-right: 11px;
}

.hutong-variable-field__global-variable {
    margin-right: 20px;
}

.hutong-variable-field__global-icon {
    background-image: var(--hutong-editor-global-icon);
    margin-right: 4px;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    align-self: center;
    opacity: 0.5;
    border-width: 0;
    background-color: rgba(0,0,0,0);
    cursor: link;
}

.hutong-variable-field__debug-value {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.hutong-variable-field__debug-toggle {
    margin-left: 0;
    width: 16px;
    height: 16px;
    background-image: var(--hutong-editor-debug-watch-icon);
    opacity: 0.25;
}

.hutong-variable-field__debug-toggle:hover {
    background-color: transparent;
    opacity: 0.5;
}

.hutong-variable-field__debug-toggle--enabled:hover {
    background-color: transparent;
    opacity: 1;
}

.hutong-variable-field__debug-toggle--enabled {
    opacity: 1;
}

/*
 Event Field
 */

.hutong-event-field {
    background-color: var(--hutong-editor-colors-header-background);
    padding-left: 4px;
    padding-right: 4px;
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    height: 24px;
}

.hutong-custom-list-view-item--selected .hutong-event-field {
    background-color: transparent;
}

.hutong-event-field__icon {
    margin-left: 2px;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

.hutong-event-field__right-aligned {
    flex-direction: row-reverse;
    align-items: center;
    position: absolute;
    right: 40px;
    top: 0;
    bottom: 0;
    justify-content: center;
}

.hutong-event-field__name {
    margin-left: 4px;
    flex-grow: 1;
}

.hutong-event-field__global-icon {
    background-image: var(--hutong-editor-global-icon);
    opacity: 0.5;
    cursor: link;
    border-width: 0;
    background-color: rgba(0,0,0,0);
}

.hutong-event-field__event-data-icon {
    background-image: var(--hutong-editor-event-data-icon);
    opacity: 0.5;
}

.hutong-event-field__used-count {
    color: var(--hutong-editor-colors-white);
}

.hutong-event-data-gui__icon {
    background-image: var(--hutong-editor-event-data-icon);
    opacity: 0.5;
}

/*
 Debug
 */

.hutong-debug-highlight {
    position: absolute;
    top: 0;
    left : 0;
    right: 0;
    bottom: 0;
    border-width: 3px;
    border-color: red;
}

.hutong-action-summary {
    flex-direction: row;
    min-width: 0;
}

.hutong-action-summary__text {
    -unity-font-style: normal;
    color: var(--unity-colors-default-text);
}

.hutong-action-summary__error {
    color: red;
}

.hutong-action-summary__parameter {
    -unity-font-style: bold;
    /*
    background-color: rgba(0,0,0,0.1);
    padding-left: 2px;
    padding-right: 2px;
    border-radius: 2px;*/
}

.hutong-action-summary__parameter--ellipsis {
    flex-shrink: 1;
    flex-grow: 0;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.hutong-action-summary__parameter--string-ellipsis {
    min-width: 18px;
}

.hutong-action-summary__icon 
{
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    margin-top: 1px;
    margin-right: 2px;
}

/*
  VariableTypeField
 */

.hutong-variable-type-field {
    flex-direction: row;
    align-items: center;
}


.hutong-variable-type-field__label {
    width: 100px;
    min-width: 100px;
    max-width: 100px;
    margin-left: 3px;
}

.hutong-variable-type-field__button {
    margin-left: 2px;
}

/*
  VariableValueField
 */

.hutong-variable-value-field > .unity-base-field {
    margin-left: 3px;
    border-left-width: 0;
    padding-left: 0;
}

.hutong-variable-value-field > .unity-base-field > Label {
    width: 40%;
    min-width: 40px;
}

.hutong-variable-value-field > .hutong-enum-flags-field > .unity-base-field__input {
    margin-left: 0;
}

.hutong-variable-editor .hutong-variable-value-field > .unity-base-field > Label {
    width: 100px;
}

.hutong-variable-value-field > ListView {
    margin-top: 4px;
    margin-right: 2px;
    margin-left: 2px;
}

.hutong-variable-value-field > ListView > Foldout > .unity-foldout__content {
    margin-top: 4px;
}

.hutong-variable-value-field__list-view {
    margin-bottom: 4px;
    margin-right: 5px;
}


/*
  FsmTemplateSelector
 */

/*wide
.hutong-fsm-controls-editor {
    margin-left: -8px;
    margin-bottom: 2px;
}

.hutong-fsm-template-runner-editor >.hutong-fsm-play-mode-gui {
    margin-left: 8px;
    margin-right: 4px;
    margin-top: 2px;
}

.hutong-fsm-controls-editor EditorOnlyListView {
    margin-left: -2px;
}
*/

.hutong-fsm-template-selector {
    flex-direction: row;
    margin-left: 0;
}

.hutong-fsm-template-selector__object-field {
    margin-left: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.hutong-fsm-template-selector__object-field > Label{
    /*wide margin-left: 9px;*/
    min-width: 70px;
}

.hutong-fsm-template-selector__edit-button {
    width: 40px;
}

/*
  FsmTemplateEditor
 */

.hutong-fsm-template-editor .hutong-node-inspector-header__name {
    margin-right: 41px;
}

.hutong-fsm-template-editor__used-count-label {
    position: absolute;
    right: 0;
    top: 44px;
}

/*
   Weighted Lists
 */

.hutong-weighted-list {
    padding-left: 9px;
    margin-right: 3px;
}

.hutong-weighted-list__title {
    margin-bottom: 4px;
}

.hutong-weighted-list ListView > Foldout > Toggle {
    margin-bottom: 4px;
}


.hutong-weighted-list ListView .unity-list-view__reorderable-item__container {
    padding-left: 0;
}

.hutong-var-slider-field {
    flex-direction: row;
    flex-grow: 1;
}

.hutong-var-slider-field__slider {
    flex-grow: 1;
    margin-right: 8px;
}

.hutong-var-slider-field__value {
    width: 80px;
    flex-shrink: 1;
    margin: 0;
    margin-left: 4px;
}

.hutong-vector2var-min-max-field > Vector2Field {
    margin-right: 0;
}

.hutong-vector2var-min-max-field > Vector2Field > Label {
    width: 40%;
    margin-right: 10px;
}

.hutong-vector2var-min-max-field .unity-composite-field__field-spacer {
    display: none;
}

.hutong-key-code-field__input {
    margin: 0;
}

.hutong-key-code-field__input-arrow {
    position: absolute;
    right: 4px;
}

/* Last so it always applies */
.hutong-root-field {
    padding-left: 0;
}

DebugDisplayField {
    padding-left: 8px;
}

.hutong-root-field > Foldout {
    margin-left: 2px;
}

.hutong-dimmed {
    opacity: 0.3;
}

.show {
    display: flex;
}

.warning-icon {
    width: 16px;
    height: 16px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 4px;
}
