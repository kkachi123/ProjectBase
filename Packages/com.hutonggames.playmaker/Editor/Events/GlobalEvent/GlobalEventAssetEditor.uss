.hutong-global-event-asset-editor {
}

.hutong-global-event-asset-editor > .hutong-event-editor {
    padding-left: 0;
}

.hutong-global-event-asset-editor__test-data {
    margin-top: 10px;
}

.hutong-global-event-used-count-label {
    color: var(--hutong-editor-colors-white);
}

/*
.hutong-global-event-test-data-editor {
    margin-top: 16px;
}
*/

.hutong-global-event-test-data-editor__title {
    padding-left: 2px;
    padding-bottom: 2px;
    -unity-font-style: bold;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-inspector_titlebar-border_accent);
    margin-bottom: 3px;
}

.hutong-global-event-subscribers-list-view {
    margin-top: 32px;
}

.hutong-global-event-subscribers-list-view__list-view {
    flex-grow: 1;
    background-color: var(--unity-colors-input_field-background);
    border-color: var(--unity-colors-input_field-border);
    border-width: 1px;
    border-radius: 3px;
}

.hutong-subscriber-item {
    flex-direction: row;
    align-items: center;
    padding: 4px;
}

.hutong-subscriber-item__label {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.hutong-global-event-asset-editor__references {
    margin-top: 20px
}

.hutong-global-event-asset-editor__references-heading {
    flex-grow: 1;
    margin-top: 10px;
    flex-direction: row;
    height: 20px;
    max-height: 20px;
    align-items: center;
    background-color: transparent;
}

.hutong-global-event-asset-editor__references-title {
    -unity-font-style: bold;
    flex-grow: 1;
}

.hutong-global-event-asset-editor__refresh-button {
    height: 20px;
}

.hutong-global-event-asset-editor__references-list {
    flex-grow: 1;
    background-color: var(--unity-colors-input_field-background);
    border-color: var(--unity-colors-input_field-border);
    border-width: 1px;
    border-radius: 3px;
}

.hutong-global-event-asset-editor__used-count {
    -unity-text-align: middle-right;
    width: 34px;
    justify-content: center;
    border-radius: 9px;
    margin-left: 4px;
    padding-right: 6px;
    margin-right: 0;
    color: var(--unity-colors-helpbox-text);
    background-color: rgba(0,0,0,0.1);
    height: 18px;
}

