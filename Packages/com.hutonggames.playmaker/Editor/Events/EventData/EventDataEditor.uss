
.hutong-event-data-editor {
    margin-top: 16px;
}

.hutong-event-data-editor > SectionHeader {
    margin-bottom: 0;
}

.hutong-event-data-editor__add-button {
    height: 18px;
    border-width: 0;
    margin-top: 4px;
    margin-left: 0;
    align-self: flex-end;
}

.hutong-event-data-editor__add-button:hover {
    border-width: 1px;
    background-color: var(--unity-colors-button-background-hover);
}

.hutong-event-data-editor__empty-hint {
    position: absolute;
    margin-top: 8px;
    margin-bottom: 10px;
    -unity-text-align: middle-left;
    opacity: 0.5;
    white-space: normal;
}

.hutong-event-data-list-view__item {
    margin-left: 2px;
    padding-bottom: 4px;
    flex-grow: 1;
}

.hutong-event-data-list-view__item-header {
    flex-direction: row;
    flex-grow: 1;
    align-items: center;
    height: 24px;
}

.hutong-event-data-list-view__item-foldout {
    background-image: var(--hutong-editor-foldout-icon);
    background-color: rgba(0,0,0,0);
    border-width: 0;
    width:14px;
    height:14px;
    flex-shrink: 0;
    margin-left:2px;
}

.hutong-event-data-list-view__item-foldout:checked {
    background-image: var(--hutong-editor-foldout-on-icon);
}

.hutong-event-data-list-view__item-name {
    margin-left: 2px;
    flex-shrink: 1;
    flex-grow: 1;
}

.hutong-event-data-list-view__item-description {
    margin-left: 2px;
    margin-top: 1px;
    margin-bottom: 2px;
    opacity: 0.7;
}


.hutong-event-data-list-view__item-type {
    width: 40%;
    min-width: 100px;
    max-width: 250px;
    flex-shrink: 0;
}
