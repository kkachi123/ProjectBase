.hutong-event-editor {
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 5px;
    padding-right: 5px;
    flex-grow: 1;
    flex-shrink: 0;
}

.hutong-event-editor__icon-style-button {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-left: 2px;
    margin-right: 2px;
    border-radius: 4px;
}

.hutong-event-editor__icon-style-button:hover {
    background-color: var(--unity-colors-button-background);
}

.hutong-event-editor__icon-style-button--icon {
    background-color: transparent;
    border-width: 0;
}

.hutong-event-data-editor__header {
    margin-top: 10px;
    /*margin-bottom: 5px;*/
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-inspector_titlebar-border_accent);
}

.hutong-event-editor__name-row {
    flex-direction: row;
    align-items: center;
}

.hutong-color-swatch,
.hutong-icon-selector-button {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-left: 2px;
    margin-right: 2px;
    border-radius: 4px;
}

.hutong-icon-selector-button:hover {
    background-color: var(--hutong-icon-button-hover-color);
}

.hutong-icon-selector-button--empty {
    border-width: 1px;
    border-color: dimgrey;
}

.hutong-event-editor__name {
    margin-left: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.hutong-event-editor__tooltip {
    margin-top: 4px;
    white-space: normal;
    max-height: 100px;
    flex-wrap: wrap;
}

.hutong-event-editor__info {
    margin-top: 4px;
}

.hutong-event-editor__name-error {
    margin-left: 4px;
    margin-bottom: 5px;
    display: none;
}
