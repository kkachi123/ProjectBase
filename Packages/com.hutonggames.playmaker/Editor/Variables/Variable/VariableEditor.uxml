    <ui:Label text="Error" name="error" picking-mode="Ignore" class="error-text hutong-editor-error-text hutong-variable-editor__error-text"  />
    <ui:TextField picking-mode="Ignore" label="Name" name="name" is-delayed="true" class="hutong-variable-editor__field-label" />
    <ui:TextField picking-mode="Ignore" name="description" multiline="true" label="Description" is-delayed="true" class="hutong-variable-editor__description hutong-variable-editor__field-label" />
