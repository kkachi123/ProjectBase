<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Packages/com.hutonggames.playmaker/Editor/Variables/Variable/VariableEditor.uss?fileID=7433441132597879392&amp;guid=4b1d2aa3d8f17544a872501e37ba6547&amp;type=3#VariableEditor" />
