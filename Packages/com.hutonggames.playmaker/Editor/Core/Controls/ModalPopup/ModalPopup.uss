.hutong-modal-popup__background {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.23);
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.hutong-modal-popup__window {
    background-color: rgba(255, 255, 255, 255);
}
