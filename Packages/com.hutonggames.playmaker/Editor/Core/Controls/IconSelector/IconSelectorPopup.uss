.hutong-icon-selector-popup {
}

.hutong-icon-selector-popup > ScrollView {
    flex-wrap: wrap;
}

.hutong-icon-selector-popup__swatch-button {
    width: 32px;
    height: 32px;
    background-color: transparent;
    border-radius: 4px;
    border-width: 0;
}

.hutong-icon-selector-popup__swatch-button--empty {
    border-width: 1px;
    border-color: dimgrey;
}

.hutong-icon-selector-popup__swatch-button--selected {
    border-color: var(--unity-colors-highlight-background);
    border-width: 2px;
}

.hutong-icon-selector-popup__swatch-button:hover {
    border-color: var(--unity-colors-highlight-background);
    border-width: 1px;
}

.hutong-icon-selector-popup__icon-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.hutong-icon-selector-popup__ok-button {
    width: 100px;
}
