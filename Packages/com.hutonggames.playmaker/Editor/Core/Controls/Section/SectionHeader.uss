.hutong-section-header {
    background-color: var(--hutong-editor-colors-header-background);
    flex-direction: row;
    min-height: 26px;
    align-items: center;
    margin-top: 8px;
    margin-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--hutong-editor-colors-header-border_accent);
}

.hutong-section-header__divider {
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-inspector_titlebar-border_accent);
}

.hutong-section-header__icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-left: 0;
    margin-right: 4px;
}

.hutong-section-header__label {
    flex-grow: 1;
    -unity-font-style: bold;
    margin-left: 0;
    padding-left: 0;
}

