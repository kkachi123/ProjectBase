.hutong-icon-picker {

}

.hutong-icon-picker__search-field{
    flex-grow: 1;
    position: absolute;
    left: 40px;
    top: -22px;
    right: 10px;
    width: auto;
}

.hutong-icon-picker__results {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 10px;
}

.hutong-icon-picker__icon-button {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background-size: 22px 22px;
    background-color: rgba(255, 255, 255, 0.05);
    border-color: transparent;
    border-width: 2px;
}

.hutong-icon-picker__icon-button--selected {
    border-color: var(--unity-colors-highlight-background);
    border-width: 2px;
}