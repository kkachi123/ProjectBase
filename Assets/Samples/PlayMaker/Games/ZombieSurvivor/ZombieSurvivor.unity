  m_EditorHideFlags: 0
  m_Script: {fileID: 1503127169, guid: af56af93b18e8464f9915f7a446a8088, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Notes: '# Zombie Survivor


    A Vampire Survivors style auto-shooter.


    ##
    Features


    - Infinite level using instantiated [TerrainChunks](./Prefabs/Terrain/TerrainChunk.prefab).

    -
    [Player progression](go:PlayerProgression) using XP and DataTables.

    - [Enemy
    wave progression](go:EnemySpawner) using DataTables

    - [Weapon progression](./DataTables/Upgrades.asset)
    using DataTables.

    - Object pools for enemies and projectiles'
