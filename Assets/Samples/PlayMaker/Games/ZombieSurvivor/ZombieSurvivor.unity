    - rid: 5348540618654614162
      type: {class: CommentNode, ns: HutongGames.PlayMaker.FSM, asm: PlayMaker.Runtime}
      data:
        _name: 
        _guid:
          _value0: 10820323877780837429
          _value1: 18058650004956093399
        _description: '### Damage system:


          - Check all overlapping enemies.

          -
          Find the enemy that has the highest power.

          - Apply that power
          as damage.

          - Invulnerable for short amount of time.

          -
          Repeat.'
